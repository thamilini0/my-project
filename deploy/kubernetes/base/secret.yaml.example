# Copy to secret.yaml locally only — DO NOT commit real values.
# Prefer: kubectl create secret generic order-service-db --from-literal=DATABASE_URL=...
apiVersion: v1
kind: Secret
metadata:
  name: order-service-db
  labels:
    app: order-service
type: Opaque
stringData:
  DATABASE_URL: postgresql://USER:PASSWORD@RDS_HOST:5432/orders
